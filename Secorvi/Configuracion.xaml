<Page x:Class="Secorvi.Configuracion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Configuracion" Background="#0B0D12" Foreground="#D1D5DB">

    <Page.Resources>
        <!-- Estilo General para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="CaretBrush" Value="#FFB300"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo General para PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="CaretBrush" Value="#FF5252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo General para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="#0F111A"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Estilo para Etiquetas -->
        <Style TargetType="TextBlock" x:Key="LblStyle">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Estilo de Botones -->
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFB300"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#101217"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFB300"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1A1F26"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161920"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E2530"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚙" Foreground="#FFB300" FontSize="26" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ADMINISTRACIÓN" Foreground="#6B7280" FontSize="10" FontWeight="Black"/>
                <TextBlock Text="PANEL DE CONFIGURACIÓN" Foreground="#E0E0E0" FontSize="20" FontWeight="Black"/>
            </StackPanel>
        </StackPanel>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- PESTAÑA 1: GESTIÓN DE PERSONAL -->
            <TabItem Header="GESTIÓN DE PERSONAL">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- BARRA DE BÚSQUEDA AGREGADA -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FILTRAR PERSONAL (NOMBRE / USUARIO / TEL)" Style="{StaticResource LblStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtBusqueda" TextChanged="TxtBusqueda_TextChanged" Margin="0" Tag="BUSCAR AGENTE..."/>
                            </StackPanel>

                            <!-- Contador para ActualizarContadorUI() -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,5">
                                <TextBlock x:Name="lblContador" Text="0 AGENTES" Foreground="#FFB300" FontSize="12" FontWeight="Black" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- TABLA DE EMPLEADOS -->
                        <Border Grid.Row="1" Background="#0F111A" CornerRadius="4" BorderBrush="#2D323E" BorderThickness="1">
                            <DataGrid x:Name="dgEmpleados" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                                      SelectionChanged="dgEmpleados_SelectionChanged" Background="Transparent" 
                                      GridLinesVisibility="None" RowHeight="40" BorderThickness="0" Foreground="#D1D5DB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding id_empleado}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFB300"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding nombre_completo}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="TEL" Binding="{Binding telefono}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- PANEL LATERAL DE EDICIÓN -->
                    <Border Grid.Column="1" Background="#0F111A" CornerRadius="4" BorderBrush="#2D323E" BorderThickness="1" Padding="20">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="DATOS DEL AGENTE" Foreground="#00D4FF" FontSize="13" FontWeight="Black" Margin="0,0,0,15"/>

                                <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource LblStyle}"/>
                                <TextBox x:Name="txtEmpNombre"/>

                                <TextBlock Text="TELÉFONO" Style="{StaticResource LblStyle}"/>
                                <TextBox x:Name="txtEmpTelefono"/>

                                <TextBlock Text="USUARIO" Style="{StaticResource LblStyle}"/>
                                <TextBox x:Name="txtEmpUsuario"/>

                                <TextBlock Text="CONTRASEÑA" Style="{StaticResource LblStyle}"/>
                                <TextBox x:Name="txtEmpPassword"/>

                                <TextBlock Text="RANGO" Style="{StaticResource LblStyle}"/>
                                <ComboBox x:Name="cmbEmpRol" SelectionChanged="cmbEmpRol_SelectionChanged">
                                    <ComboBoxItem Content="1 - ADMINISTRADOR"/>
                                    <ComboBoxItem Content="2 - SUPERVISOR"/>
                                    <ComboBoxItem Content="3 - AGENTE"/>
                                </ComboBox>

                                <Border x:Name="panelAutorizacion" Background="#2D1214" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="2" Padding="15" Margin="0,10,0,15" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ AUTORIZACIÓN REQUERIDA" Foreground="#FF5252" FontSize="10" FontWeight="Black" Margin="0,0,0,10"/>
                                        <TextBlock Text="USUARIO:" Style="{StaticResource LblStyle}" Foreground="#FF8A8A"/>
                                        <TextBox x:Name="txtAuthUsuario" Background="#16080A" BorderBrush="#FF5252"/>
                                        <TextBlock Text="CONTRASEÑA:" Style="{StaticResource LblStyle}" Foreground="#FF8A8A"/>
                                        <PasswordBox x:Name="txtAuthPassword" Background="#16080A" BorderBrush="#FF5252"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnGuardarEmpleado" Content="GUARDAR CAMBIOS" Background="#2ECC71" Foreground="#0F111A" Padding="0,12" Margin="0,10,0,0" Click="btnGuardarEmpleado_Click"/>

                                <!-- BOTÓN DE ELIMINAR AGREGADO AQUÍ -->
                                <Button x:Name="btnEliminarEmpleado" Content="ELIMINAR AGENTE" Background="#2D1214" Foreground="#FF5252" BorderBrush="#FF5252" BorderThickness="1" Padding="0,10" Margin="0,10,0,0" Click="btnEliminarEmpleado_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: ZONAS Y UBICACIONES -->
            <TabItem Header="ZONAS Y UBICACIONES">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: LISTADO Y FILTRO -->
                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- BARRA DE BÚSQUEDA DE UBICACIONES -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FILTRAR ZONAS (NOMBRE DEL LUGAR)" Style="{StaticResource LblStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtBusquedaUbi" TextChanged="TxtBusquedaUbi_TextChanged" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,5">
                                <TextBlock x:Name="lblContadorUbi" Text="0 ZONAS" Foreground="#3498DB" FontSize="12" FontWeight="Black" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- TABLA DE UBICACIONES -->
                        <Border Grid.Row="1" Background="#0F111A" CornerRadius="4" BorderBrush="#2D323E" BorderThickness="1">
                            <DataGrid x:Name="dgUbicaciones" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          SelectionChanged="dgUbicaciones_SelectionChanged" Background="Transparent" 
                          GridLinesVisibility="None" RowHeight="40" BorderThickness="0" Foreground="#D1D5DB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LUGAR" Binding="{Binding nombre_lugar}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- COLUMNA DERECHA: PANEL DE EDICIÓN -->
                    <Border Grid.Column="1" Background="#0F111A" CornerRadius="4" BorderBrush="#2D323E" BorderThickness="1" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="GESTIÓN DE ZONA" Foreground="#FFB300" FontSize="13" FontWeight="Black" Margin="0,0,0,15"/>

                                <TextBlock Text="NOMBRE DEL LUGAR" Style="{StaticResource LblStyle}"/>
                                <TextBox x:Name="txtUbiNombre"/>

                                <Border Background="#161920" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="HORARIO OPERATIVO PREDETERMINADO" Foreground="#3498DB" FontSize="10" FontWeight="Black" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ENTRADA -->
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="ENTRADA" Style="{StaticResource LblStyle}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="cbUbiHoraInicio" Grid.Column="0" Margin="0,5,5,0"/>
                                                    <ComboBox x:Name="cbUbiAmPmInicio" Grid.Column="1" Margin="0,5,0,0" Width="50">
                                                        <ComboBoxItem Content="AM"/>
                                                        <ComboBoxItem Content="PM"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>

                                            <!-- SALIDA -->
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="SALIDA" Style="{StaticResource LblStyle}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="cbUbiHoraFin" Grid.Column="0" Margin="0,5,5,0"/>
                                                    <ComboBox x:Name="cbUbiAmPmFin" Grid.Column="1" Margin="0,5,0,0" Width="50">
                                                        <ComboBoxItem Content="AM"/>
                                                        <ComboBoxItem Content="PM"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnGuardarUbicacion" Content="GUARDAR CAMBIOS" Background="#FFB300" Foreground="#0F111A" Padding="0,12" Margin="0,10,0,0" Click="btnGuardarUbicacion_Click" BorderThickness="0"/>
                                <Button x:Name="btnEliminarUbicacion" Content="ELIMINAR ZONA" Background="#2D1214" Foreground="#FF5252" BorderBrush="#FF5252" BorderThickness="1" Padding="0,10" Margin="0,10,0,0" Click="btnEliminarUbicacion_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="REGISTROS INACTIVOS">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#0F111A" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2D1214" Padding="15">
                            <TextBlock Text="AGENTES DADOS DE BAJA" Foreground="#FF5252" FontSize="13" FontWeight="Black"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="10,10,10,0">
                            <TextBlock Text="BUSCAR AGENTE INACTIVO" Style="{StaticResource LblStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBusquedaInactivosEmp" TextChanged="txtBusquedaInactivosEmp_TextChanged" Margin="0"/>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="#2D323E" BorderThickness="1,0,1,1" Margin="0,10,0,0">
                            <DataGrid x:Name="dgEmpleadosInactivos" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                                      SelectionChanged="dgEmpleadosInactivos_SelectionChanged" Background="Transparent" 
                                      GridLinesVisibility="None" RowHeight="40" BorderThickness="0" Foreground="#D1D5DB" Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding id_empleado}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFB300"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding nombre_completo}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Button x:Name="btnReactivarEmpleado" Grid.Row="3" Content="REACTIVAR AGENTE" 
                                Background="#2ECC71" Foreground="#0F111A" Padding="0,12" Margin="0,15,0,0" 
                                Click="btnReactivarEmpleado_Click" IsEnabled="False" Opacity="0.5"/>
                    </Grid>

                    <Grid Grid.Column="2" Background="#0F111A" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2D1214" Padding="15">
                            <TextBlock Text="ZONAS OCULTAS" Foreground="#FF5252" FontSize="13" FontWeight="Black"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="10,10,10,0">
                            <TextBlock Text="BUSCAR ZONA INACTIVA" Style="{StaticResource LblStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBusquedaInactivosUbi" TextChanged="txtBusquedaInactivosUbi_TextChanged" Margin="0"/>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="#2D323E" BorderThickness="1,0,1,1" Margin="0,10,0,0">
                            <DataGrid x:Name="dgUbicacionesInactivas" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                                      SelectionChanged="dgUbicacionesInactivas_SelectionChanged" Background="Transparent" 
                                      GridLinesVisibility="None" RowHeight="40" BorderThickness="0" Foreground="#D1D5DB" Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LUGAR" Binding="{Binding nombre_lugar}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Button x:Name="btnReactivarUbicacion" Grid.Row="3" Content="REACTIVAR ZONA" 
                                Background="#FFB300" Foreground="#0F111A" Padding="0,12" Margin="0,15,0,0" 
                                Click="btnReactivarUbicacion_Click" IsEnabled="False" Opacity="0.5"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>