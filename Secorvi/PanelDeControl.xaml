<Page x:Class="Secorvi.PanelDeControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="SECORVI - Panel de Control" 
      d:DesignHeight="720" d:DesignWidth="1060"
      Background="#0B0D12" Language="es-MX"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="TerminalInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFB300"/>
        </Style>

        <Style x:Key="IndustrialButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#161A21"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2530"/>
                                <Setter Property="BorderBrush" Value="#FFB300"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionGridButton" TargetType="Button" BasedOn="{StaticResource IndustrialButtonStyle}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#101217"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1A1F26"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F111A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="0,0,0,20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" RenderTransformOrigin="0.603,0.651">
                    <TextBlock Text="GESTIÓN DE AGENTES" Foreground="White" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="#2D323E" Margin="20,5" Height="25"/>
                    <Button Content="+ REGISTRAR" Click="BtnNuevo_Click" Style="{StaticResource IndustrialButtonStyle}" Background="#FFB300" Foreground="#0F111A" Width="140"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#161920" Padding="15,10" CornerRadius="4,4,0,0" BorderBrush="#2D323E" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍 FILTRAR TERMINAL:" Foreground="#4B5563" FontWeight="Bold" VerticalAlignment="Center" FontSize="10" Margin="0,0,15,0"/>
                <TextBox x:Name="txtBusqueda" Grid.Column="1" Height="30" Style="{StaticResource TerminalInputStyle}" TextChanged="TxtBusqueda_TextChanged" BorderThickness="0,0,0,1" Background="Transparent"/>
                <TextBlock Grid.Column="2" x:Name="lblTotal" Text="AGENTES: 0" Foreground="#FFB300" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="10" FontWeight="Black"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0F111A" BorderBrush="#2D323E" BorderThickness="1,0,1,1">
            <DataGrid x:Name="dgEmpleados" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Background="Transparent" RowHeight="60" HeadersVisibility="Column" 
                      IsReadOnly="True" GridLinesVisibility="None" BorderThickness="0"
                      MouseDoubleClick="DgEmpleados_MouseDoubleClick"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID" Binding="{Binding id_empleado}" Width="Auto" MinWidth="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFB300"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Black"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- COLUMNA DE ROL / ACCESO -->
                    <DataGridTemplateColumn Header="NIVEL ACCESO" Width="Auto" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="RoleBadge" CornerRadius="2" Padding="8,2" Margin="5,0" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="RoleText" Text="AGENTE" FontSize="9" FontWeight="Black" HorizontalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Lógica para ADMINISTRADOR (ID Rol 1) -->
                                    <DataTrigger Binding="{Binding id_rol}" Value="1">
                                        <Setter TargetName="RoleBadge" Property="Background" Value="#2D1214"/>
                                        <Setter TargetName="RoleBadge" Property="BorderBrush" Value="#FF5252"/>
                                        <Setter TargetName="RoleText" Property="Text" Value="ADMINISTRADOR"/>
                                        <Setter TargetName="RoleText" Property="Foreground" Value="#FF5252"/>
                                    </DataTrigger>

                                    <!-- Lógica para SUPERVISOR (ID Rol 2) -->
                                    <DataTrigger Binding="{Binding id_rol}" Value="2">
                                        <Setter TargetName="RoleBadge" Property="Background" Value="#0A2135"/>
                                        <Setter TargetName="RoleBadge" Property="BorderBrush" Value="#3498DB"/>
                                        <Setter TargetName="RoleText" Property="Text" Value="SUPERVISOR"/>
                                        <Setter TargetName="RoleText" Property="Foreground" Value="#3498DB"/>
                                    </DataTrigger>

                                    <!-- Lógica para AGENTE (ID Rol 3) -->
                                    <DataTrigger Binding="{Binding id_rol}" Value="3">
                                        <Setter TargetName="RoleBadge" Property="Background" Value="#1A1F26"/>
                                        <Setter TargetName="RoleBadge" Property="BorderBrush" Value="#9CA3AF"/>
                                        <Setter TargetName="RoleText" Property="Text" Value="AGENTE"/>
                                        <Setter TargetName="RoleText" Property="Foreground" Value="#9CA3AF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="AGENTE / OPERADOR" Binding="{Binding nombre_completo}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding telefono}" Width="Auto" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <!-- Tono gris para no quitar protagonismo al nombre -->
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <!-- Estilo terminal -->
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ESTATUS ASISTENCIA" Width="Auto" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="10,4" Margin="10,15" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A1F26"/>
                                            <Setter Property="BorderBrush" Value="#2D323E"/>
                                            <Style.Triggers>
                                                <!-- 1. ASISTENCIA (A tiempo: Verde) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="ASISTENCIA">
                                                    <Setter Property="Background" Value="#0A2D1B"/>
                                                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                </DataTrigger>

                                                <!-- 2. RETRASO (Fuera de tolerancia: Amarillo/Naranja) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="RETRASO">
                                                    <Setter Property="Background" Value="#2D240A"/>
                                                    <Setter Property="BorderBrush" Value="#F1C40F"/>
                                                </DataTrigger>

                                                <!-- 3. FALTA (No llegó: Rojo) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="FALTA">
                                                    <Setter Property="Background" Value="#2D1214"/>
                                                    <Setter Property="BorderBrush" Value="#FF5252"/>
                                                </DataTrigger>

                                                <!-- 4. PROGRAMADO (Futuro: Azul) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="PROGRAMADO">
                                                    <Setter Property="Background" Value="#161920"/>
                                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                                </DataTrigger>

                                                <!-- 5. DESCANSO (Día libre: Gris) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="DESCANSO">
                                                    <Setter Property="Background" Value="#1A1F26"/>
                                                    <Setter Property="BorderBrush" Value="#6B7280"/>
                                                </DataTrigger>

                                                <!-- 6. VACACIONES (Azul claro/Cyan) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="VACACIONES">
                                                    <Setter Property="Background" Value="#0A2135"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                </DataTrigger>

                                                <!-- 7. SALIDA (Turno Finalizado: Morado) -->
                                                <DataTrigger Binding="{Binding estatus_asistencia}" Value="SALIDA">
                                                    <Setter Property="Background" Value="#1D122D"/>
                                                    <Setter Property="BorderBrush" Value="#9B59B6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding estatus_asistencia}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TURNO OPERATIVO" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="INFO TURNO:" Foreground="#4B5563" FontSize="8" FontWeight="Black"/>
                                    <TextBlock Text="{Binding info_turno}" Foreground="#9CA3AF" FontSize="11" FontFamily="Consolas"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="GESTIÓN" Width="Auto" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="CALENDARIO" Click="BtnCalendario_Click" Style="{StaticResource ActionGridButton}" Width="90" Margin="0,0,5,0"/>
                                    <Button Content="ASIGNAR" Click="BtnAsignacion_Click" Style="{StaticResource ActionGridButton}" Width="80" BorderBrush="#2ECC71" Foreground="#2ECC71"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#101217" Padding="20,10" BorderBrush="#2D323E" BorderThickness="1,0,1,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="CONEXIÓN ESTABLE - BASE DE DATOS ACTIVA" Foreground="#4B5563" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="SECORVI v2.5.0" Foreground="#2D323E" FontSize="9" FontWeight="Black" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>