<Window x:Class="Secorvi.ContenedorPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SECORVI - Command Center" 
        Height="720" Width="1280"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen" 
        Background="#0B0D12"
        WindowStyle="None" 
        AllowsTransparency="False"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      CornerRadius="0" 
                      GlassFrameThickness="1" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ESTILO DE BOTONES DEL MENÚ LATERAL -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1F26"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2D323E"/>
                                <Setter Property="BorderBrush" Value="#00F5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DE BOTONES DE CONTROL (MIN, MAX, CLOSE) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D323E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="0" Background="#101217" BorderBrush="#1A1F26" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="SECORVI" Foreground="#FFB300" FontSize="28" FontWeight="Black"/>
                    <TextBlock Text="SECURITY OPS" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="2,-5,0,0"/>
                </StackPanel>

                <!-- MENÚ SIMPLIFICADO -->
                <StackPanel Grid.Row="1" Margin="10,20">
                    <TextBlock Text="NÚCLEO OPERATIVO" Foreground="#4B5563" FontSize="10" FontWeight="Bold" Margin="15,0,0,10"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="📊 PANEL PRINCIPAL" Click="NavPanel_Click"/>

                    <Separator Background="#1A1F26" Margin="15,15"/>

                    <TextBlock Text="REPORTES" Foreground="#4B5563" FontSize="10" FontWeight="Bold" Margin="15,0,0,10"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="⏱ GESTIÓN DE TURNOS" Click="NavTurnos_Click"/>
                    <Separator Background="#1A1F26" Margin="15,15"/>

                    <TextBlock Text="SEGURIDAD INTERNA" Foreground="#4B5563" FontSize="10" FontWeight="Bold" Margin="15,0,0,10"/>


                    <!-- FOOTER -->
                    <Border Grid.Row="2" Background="#0B0D12" Padding="15,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SISTEMA ACTIVO" Foreground="#2ECC71" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="MODO TERMINAL" Foreground="#4B5563" FontSize="10"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="🚪" 
                                ToolTip="Cerrar Sesión" Background="Transparent" BorderThickness="0" 
                                Foreground="#FF5252" FontSize="16" Cursor="Hand" Click="BtnCerrarSesion_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR (CHROME) -->
            <Border Grid.Row="0" Background="#101217">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <Ellipse Width="8" Height="8" Fill="#FFB300" Margin="0,0,10,0"/>
                        <TextBlock Text="TERMINAL DE CAMPO v2.5" Foreground="#4B5563" FontSize="10" VerticalAlignment="Center" FontWeight="Bold"/>

                        <!-- SECCIÓN NUEVA: NOMBRE DEL OPERADOR -->
                        <Rectangle Width="1" Fill="#2D323E" Margin="20,8" Height="15"/>
                        <TextBlock Text="OPERADOR:" Foreground="#4B5563" FontSize="9" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblNombreUsuario" Text="IDENTIFICANDO..." Foreground="White" FontSize="10" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Botones de control (—, 🗖, ✕) se mantienen igual -->
                        <Button Content="—" Click="BtnMin_Click" Style="{StaticResource WindowControlBtn}"/>
                        <Button Content="🗖" Click="BtnMax_Click" Style="{StaticResource WindowControlBtn}"/>
                        <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource WindowCloseBtn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- FRAME DE NAVEGACIÓN -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden">
                <Frame.Triggers>
                    <EventTrigger RoutedEvent="Frame.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Frame.Triggers>
            </Frame>
        </Grid>
    </Grid>
</Window>