<Page x:Class="Secorvi.Mapa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1200"
      Title="SECORVI - Tactical Radar" 
      Background="#0B0D12"
      Language="es-MX">

    <Page.Resources>
        <Style x:Key="TerminalInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#12161D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="IndustrialButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1F26"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DARK REFORZADO: EVITA EL FONDO BLANCO AL INICIO -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#12161D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="1" 
                                          Foreground="White"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Path Name="Arrow" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder" Background="#12161D" BorderThickness="1" BorderBrush="#2D323E"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#12161D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#161920" BorderBrush="#2D323E" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="OPERATIONAL_TARGET" Foreground="#4B5563" FontSize="9" FontWeight="Black"/>
                    <Border Background="#0F111A" CornerRadius="2" Padding="10,6" Margin="0,5,0,0" BorderBrush="#1A1F26" BorderThickness="1">
                        <TextBlock x:Name="lblEmpleadoActivo" Text="AGENTE: CARGANDO..." Foreground="#00FF41" FontSize="11" FontWeight="Black"/>
                    </Border>
                </StackPanel>

                <TextBox Grid.Row="1" 
                     x:Name="txtBusqueda" 
                     Style="{StaticResource TerminalInputStyle}" 
                     Margin="0,0,0,10" 
                     Tag="FILTRAR LISTA..." 
                     TextChanged="txtBusqueda_TextChanged"/>
                <ListBox Grid.Row="2" x:Name="lstUbicaciones" Background="Transparent" BorderThickness="0" Margin="0,0,0,10" SelectionChanged="lstUbicaciones_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101217" BorderBrush="#1A1F26" BorderThickness="1" Padding="8" Margin="0,0,0,4">
                                <TextBlock Text="{Binding nombre_lugar}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Background="#0F111A" BorderBrush="#2D323E" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TURNO_PRESETS" Foreground="#4B5563" FontSize="9" FontWeight="Black" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3" Height="30" Margin="0,0,0,12">
                            <Button Content="08H" Click="BtnTurno8_Click" Style="{StaticResource IndustrialButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="12H" Click="BtnTurno12_Click" Style="{StaticResource IndustrialButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="24H" Click="BtnTurno24_Click" Style="{StaticResource IndustrialButtonStyle}"/>
                        </UniformGrid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="INICIO" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbHoraInicio" Height="28" Style="{StaticResource DarkComboBox}"/>
                                    <ComboBox x:Name="cbAmPmInicio" Grid.Column="1" Height="28" Margin="2,0,0,0" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="AM" IsSelected="True"/>
                                        <ComboBoxItem Content="PM"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="FIN" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbHoraFin" Height="28" Style="{StaticResource DarkComboBox}"/>
                                    <ComboBox x:Name="cbAmPmFin" Grid.Column="1" Height="28" Margin="2,0,0,0" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="AM" IsSelected="True"/>
                                        <ComboBoxItem Content="PM"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <DatePicker x:Name="dpFecha" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txtNombrePunto" Style="{StaticResource TerminalInputStyle}" Margin="0,0,0,10" Tag="NOMBRE UBICACION"/>

                        <TextBlock Text="COORDINATES" Foreground="#4B5563" FontSize="9" FontWeight="Black" Margin="0,0,0,4"/>
                        <Border Background="#080A0E" Padding="8" BorderBrush="#1A1F26" BorderThickness="1">
                            <TextBlock x:Name="txtCoords" Text="[ WAITING_SIGNAL ]" Foreground="#00F5FF" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Row="4" Columns="2" Height="40">
                    <Button Content="CANCEL" Click="BtnCancelar_Click" Style="{StaticResource IndustrialButtonStyle}" Margin="0,0,5,0" Foreground="#FF5252"/>
                    <Button Content="SAVE_DATA" Click="BtnGuardar_Click" Style="{StaticResource IndustrialButtonStyle}" Background="#FFB300" Foreground="Black"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <wv2:WebView2 x:Name="mapaWebView" DefaultBackgroundColor="#0F111A"/>
        </Grid>
    </Grid>
</Page>