<Window x:Class="Secorvi.GestionPermisos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Accesos" 
        Height="650" Width="450"
        WindowStartupLocation="CenterOwner" Background="#0B0D12"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        BorderBrush="#FFB300" BorderThickness="1">

    <Window.Resources>
        <Style x:Key="TerminalInputStyle" TargetType="Control">
            <Setter Property="Background" Value="#12161D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00F5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1F26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB300"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="gd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="gd" Property="Background" Value="#FFB300"/><Setter Property="Foreground" Value="#0F111A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="gd" Property="Background" Value="#2D323E"/><Setter Property="Foreground" Value="#FFB300"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndustrialComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D323E"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Grid.Column="2" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="2" Background="#161920" BorderBrush="#2D323E" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Fill="#FFB300" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="150">
                                    <Border x:Name="DropDownBorder" Background="#161920" BorderThickness="1" BorderBrush="#2D323E"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- GRID MAESTRO PARA EVITAR CORTES -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Encabezado y Buscador -->
            <RowDefinition Height="*"/>    <!-- Contenido Scrolleable -->
            <RowDefinition Height="Auto"/> <!-- Botones (Siempre visibles) -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y BUSCADOR INTELIGENTE -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="MODIFICAR NIVEL DE ACCESO" Foreground="#FFB300" FontSize="18" FontWeight="Black" Margin="0,0,0,5"/>
            <TextBlock Text="CONFIGURACIÓN DE SEGURIDAD INTERNA" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="0,0,0,15"/>
            <Separator Background="#2D323E" Margin="0,0,0,15"/>

            <TextBlock Text="1. BUSCAR AGENTE / OPERADOR:" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <TextBox x:Name="txtBuscadorEmpleado" Style="{StaticResource TerminalInputStyle}" 
                     Margin="0,0,0,0" TextChanged="TxtBuscadorEmpleado_TextChanged"/>
            
            <TextBlock Text="Busca por Nombre, Matrícula, ID o Teléfono" Foreground="#4B5563" FontSize="9" Margin="0,5,0,5"/>

            <Border Background="#161920" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="2" MaxHeight="120" Margin="0,0,0,15">
                <ListBox x:Name="lstEmpleadosResultados" Background="Transparent" BorderThickness="0" 
                         Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         DisplayMemberPath="nombre_completo" SelectedValuePath="id_empleado"
                         SelectionChanged="LstEmpleadosResultados_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D323E"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFB300"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </StackPanel>

        <!-- PANEL DE CONFIGURACIÓN (Oculto hasta elegir un empleado) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel x:Name="panelConfiguracion" Visibility="Collapsed">
                
                <TextBlock Text="AGENTE SELECCIONADO:" Foreground="#6B7280" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="lblNombreEmpleado" Text="CARGANDO..." Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5,0,20"/>

                <TextBlock Text="2. ASIGNAR NUEVO ROL:" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbRoles" Style="{StaticResource IndustrialComboBox}" Height="40" 
                          DisplayMemberPath="Nombre" SelectedValuePath="Id"
                          SelectionChanged="CbRoles_SelectionChanged"/>

                <Border Background="#0F111A" CornerRadius="4" Padding="15" Margin="0,15,0,15" BorderBrush="#2D323E" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ALCANCE DEL ROL:" Foreground="#FFB300" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtDescripcionRol" Text="Seleccione un rol para ver los detalles..." 
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <Border x:Name="brdContrasenaUsuario" Visibility="Collapsed" Background="#0B0D12" Padding="12" CornerRadius="4" Margin="0,0,0,15" BorderBrush="#2D323E" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CLAVE DEL SISTEMA PARA ESTE USUARIO:" Foreground="#FFB300" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="txtNuevaPassUsuario" Style="{StaticResource TerminalInputStyle}" Grid.Column="0"/>
                            <TextBox x:Name="txtNuevaPassUsuarioVisible" Style="{StaticResource TerminalInputStyle}" Visibility="Collapsed" Grid.Column="0"/>
                            <Button x:Name="btnVerPass" Content="👁️" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Click="BtnVerPass_Click"/>
                        </Grid>
                        <TextBlock x:Name="lblInfoPass" Text="Esta clave le permitirá acceder al sistema de escritorio." Foreground="#6B7280" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="brdAutorizacion" Visibility="Collapsed" Background="#161920" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="⚠" Foreground="#FF5252" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FIRMA DE AUTORIZACIÓN REQUERIDA" Foreground="#FF5252" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtMensajeAutorizacion" Text="Protocolo activo." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="16"/>

                        <TextBlock Text="USUARIO AUTORIZADOR:" Foreground="#6B7280" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtUserAuth" Style="{StaticResource TerminalInputStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="CLAVE DEL AUTORIZADOR:" Foreground="#6B7280" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtPassAuth" Style="{StaticResource TerminalInputStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTONES INFERIORES FIJOS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="CANCELAR" Click="BtnCancelar_Click" Margin="0,0,5,0" Height="40" 
                    Background="#1A1F26" Foreground="#9CA3AF" BorderBrush="#2D323E"/>
            <Button Content="APLICAR CAMBIOS" x:Name="btnGuardar" Click="BtnGuardar_Click" 
                    Grid.Column="1" Margin="5,0,0,0" Height="40" 
                    Background="#FFB300" Foreground="#0B0D12" FontWeight="Black" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>