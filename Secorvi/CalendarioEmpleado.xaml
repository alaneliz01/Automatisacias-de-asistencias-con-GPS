<Page x:Class="Secorvi.CalendarioEmpleado"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#080A0F" Language="es-MX"
      Title="SECORVI - Tactical Command"
      SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Page.Resources>
        <SolidColorBrush x:Key="StateActiveRed" Color="#C21807"/>
        <SolidColorBrush x:Key="StateVacationBlue" Color="#0A84FF"/>
        <SolidColorBrush x:Key="StateOffGray" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="HudCyan" Color="#00F5FF"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFB300"/>

        <Style x:Key="TacticalButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1D26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#323846"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252936"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TacticalNavButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1D26"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Setter Property="BorderBrush" Value="#323846"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252936"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TacticalDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#1A1D26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" CornerRadius="4">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- AQUI BLOQUEAMOS LA ESCRITURA: IsReadOnly y Focusable -->
                                <DatePickerTextBox x:Name="PART_TextBox" 
                                                   Grid.Column="0" 
                                                   Foreground="{TemplateBinding Foreground}" 
                                                   Background="Transparent" 
                                                   BorderThickness="0" 
                                                   VerticalContentAlignment="Center"
                                                   Padding="5,0"
                                                   IsReadOnly="True"
                                                   Focusable="False"
                                                   IsHitTestVisible="False"/>

                                <Button x:Name="PART_Button" 
                                        Grid.Column="1" Width="30"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource AccentGold}" Content="📅"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="btnVolver" Content="← VOLVER AL PANEL" Click="BtnVolver_Click" 
                        Foreground="{StaticResource AccentGold}" Background="Transparent" 
                        BorderThickness="0" HorizontalAlignment="Left" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>

                <!-- AQUI ACHICAMOS EL TEXTO (FontSize="22") -->
                <TextBlock x:Name="lblNombreEmpleado" Text="CARGANDO..." Foreground="White" 
                           FontSize="22" FontWeight="Black" Margin="0,2,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="15" Color="White" Opacity="0.1" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="lblFechaHoraActual" Text="SINCRO_DATA_ACTIVE" Foreground="{StaticResource HudCyan}" 
                           FontSize="10" FontWeight="Bold" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
                <Button Content="‹" Style="{StaticResource TacticalNavButton}" Width="45" Height="40" Click="BtnSemanaAtras_Click"/>

                <Border Margin="10,0" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#FFB300" Opacity="0.2" ShadowDepth="0"/>
                    </Border.Effect>
                    <DatePicker x:Name="dpSaltoFecha" 
                                Style="{StaticResource TacticalDatePicker}"
                                Width="150" Height="40" 
                                SelectedDateChanged="DpSaltoFecha_SelectedDateChanged"/>
                </Border>

                <Button Content="›" Style="{StaticResource TacticalNavButton}" Width="45" Height="40" Click="BtnSemanaAdelante_Click"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="btnAsignacion" Content="+ ASIGNACIÓN RÁPIDA" 
                    Style="{StaticResource TacticalButton}" Background="{StaticResource AccentGold}" 
                    Foreground="Black" Width="200" Height="40" Click="BtnAsignarHorario_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="#101218" CornerRadius="8" Padding="25,15" Margin="0,0,0,15" BorderBrush="#1F232B" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DESPLIEGUES:" Foreground="#4B5563" FontSize="10" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblTotalServicios" Text="0" Foreground="{StaticResource StateActiveRed}" FontSize="24" FontWeight="Black" Margin="0,0,35,0"/>

                    <TextBlock Text="DESCANSOS:" Foreground="#4B5563" FontSize="10" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblTotalDescansos" Text="0" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,0,35,0"/>

                    <TextBlock Text="LICENCIAS:" Foreground="#4B5563" FontSize="10" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblTotalVacaciones" Text="0" Foreground="{StaticResource StateVacationBlue}" FontSize="24" FontWeight="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="lblRangoSemana" Text="---" Foreground="{StaticResource AccentGold}" FontWeight="Black" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#0C0E14" BorderBrush="#1F232B" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="GridCalendario" Background="Transparent"/>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#00FF41" Margin="0,0,10,0"/>
                <TextBlock Text="CORE_SINCRO: ONLINE" Foreground="#00FF41" FontSize="9" FontWeight="Black" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="SECORVI TERMINAL v2.5.0" Foreground="#1F232B" FontSize="10" FontWeight="Black" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Page>