<Window x:Class="Secorvi.ConfirmarEliminacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar Baja" Height="250" Width="400" 
        Background="#1A1A1A" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="#FF4B4B" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock x:Name="lblInstruccion" Text="Para inactivar, escriba el nombre completo del agente:"
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5" HorizontalAlignment="Center"/>

            <TextBlock x:Name="lblNombreAgente" 
                       Foreground="#FF4B4B" FontSize="18" FontWeight="Black" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBox x:Name="txtNombreConfirmar" 
                     Height="40" Background="Black" Foreground="#FFC107" 
                     BorderBrush="#FFC107" BorderThickness="0,0,0,2"
                     FontSize="14" FontWeight="Bold" Padding="5,0"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     TextChanged="TxtNombreConfirmar_TextChanged"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCELAR" Click="BtnCancelar_Click" 
                        Height="40" Background="#333" Foreground="White" BorderThickness="0"/>

                <Button x:Name="btnEliminar" Grid.Column="2" Content="CONFIRMAR" 
                        Click="BtnEliminar_Click" Height="40" 
                        Background="#440000" Foreground="#FF4B4B" BorderBrush="#FF4B4B" BorderThickness="1"
                        IsEnabled="False" Opacity="0.5"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>