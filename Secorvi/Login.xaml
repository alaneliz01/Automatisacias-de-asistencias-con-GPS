<Window x:Class="Secorvi.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SECORVI - Access Terminal" Height="372" Width="360"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="TerminalEntryStyle" TargetType="Control">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00F5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFB300"/>
            <Setter Property="Foreground" Value="#0B0D12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                                <Setter Property="Background" Value="#FFC300"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Background="#0B0D12" Margin="0,0,0,10">
        <Grid Margin="30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="SECORVI" Foreground="#FFB300" FontSize="32" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="OPS_TERMINAL_V2.5" Foreground="#00F5FF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nombre de usuario" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUser" Style="{StaticResource TerminalEntryStyle}" CaretBrush="#FFB300" Margin="0,0,0,20"/>

                <TextBlock Text="Contrasena" Foreground="#4B5563" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtPass" Style="{StaticResource TerminalEntryStyle}" Foreground="#FFB300" CaretBrush="#00F5FF" Margin="0,0,0,10"/>
            </StackPanel>

            <Border Grid.Row="2" x:Name="brdStatus" Height="28" Margin="0,10" Visibility="Collapsed">
                <TextBlock x:Name="txtStatusMsg" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold"/>
            </Border>

            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                <Button Content="EXECUTE_LOGIN" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Height="40" Click="BtnLogin_Click"/>

                <Button Content="SHUTDOWN_SYSTEM" Click="BtnSalir_Click" Background="Transparent" Foreground="#30363D" 
                        FontSize="8" FontWeight="Bold" BorderThickness="0" Margin="0,12,0,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF5252"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>